{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
    <div class="container mx-auto px-4 py-8">
        <div class="bg-white rounded-lg shadow-xl p-6">
            <div class="flex justify-between items-center mb-6">
                <h1 class="text-3xl font-bold text-gray-900">Catégories</h1>
                <a href="{{ path('category_new') }}"
                   class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                    + Nouvelle Catégorie
                </a>
            </div>

            {% for message in app.flashes('success') %}
                <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-4">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('danger') %}
                <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-4">
                    {{ message }}
                </div>
            {% endfor %}

            <!-- Modal -->
            <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5" id="exampleModalLabel">Modal title</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            Vous allez supprimer la catégorie INTEL, êtes-vous sûr de vouloir continuer ?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="button" class="btn btn-primary">Save changes</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full bg-white">
                    <thead>
                        <tr>
                            <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                Nom
                            </th>
                            <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                Slug
                            </th>
                            <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                Description
                            </th>
                            <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for category in categories %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 border-b border-gray-200">
                                {{ category.name }}
                            </td>
                            <td class="px-6 py-4 border-b border-gray-200">
                                <code class="bg-gray-100 px-2 py-1 rounded text-sm">{{ category.slug }}</code>
                            </td>
                            <td class="px-6 py-4 border-b border-gray-200">
                                {{ category.description|default('—')|slice(0, 100) }}{% if category.description|length > 100 %}...{% endif %}
                            </td>
                            <td class="px-6 py-4 border-b border-gray-200">
                                <div class="flex space-x-2">
                                    <a href="{{ path('category_show', {'id': category.id}) }}"
                                       class="text-blue-600 hover:text-blue-900">Voir</a>
                                    <a href="{{ path('category_edit', {'id': category.id}) }}"
                                       class="text-green-600 hover:text-green-900">Éditer</a>
                                    {{ include('category/_delete_form.html.twig', {'category': category}) }}

                                    <!-- Button trigger modal -->
                                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                        Launch demo modal
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="4" class="px-6 py-4 border-b border-gray-200 text-center">
                                Aucune catégorie trouvée.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
