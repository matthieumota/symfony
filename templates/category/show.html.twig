{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
    <div class="container mx-auto px-4 py-8">
        <div class="bg-white rounded-lg shadow-xl p-6 max-w-2xl mx-auto">
            <h1 class="text-3xl font-bold text-gray-900 mb-6">{{ category.name }}</h1>

            <table class="min-w-full">
                <tr>
                    <th class="px-4 py-2 text-left font-semibold text-gray-700">ID</th>
                    <td class="px-4 py-2">{{ category.id }}</td>
                </tr>
                <tr>
                    <th class="px-4 py-2 text-left font-semibold text-gray-700">Nom</th>
                    <td class="px-4 py-2">{{ category.name }}</td>
                </tr>
                <tr>
                    <th class="px-4 py-2 text-left font-semibold text-gray-700">Slug</th>
                    <td class="px-4 py-2"><code>{{ category.slug }}</code></td>
                </tr>
                <tr>
                    <th class="px-4 py-2 text-left font-semibold text-gray-700">Description</th>
                    <td class="px-4 py-2">{{ category.description|default('—') }}</td>
                </tr>
                <tr>
                    <th class="px-4 py-2 text-left font-semibold text-gray-700">Créé le</th>
                    <td class="px-4 py-2">{{ category.createdAt ? category.createdAt|date('Y-m-d H:i:s') : '—' }}</td>
                </tr>
                <tr>
                    <th class="px-4 py-2 text-left font-semibold text-gray-700">Mis à jour le</th>
                    <td class="px-4 py-2">{{ category.updatedAt ? category.updatedAt|date('Y-m-d H:i:s') : '—' }}</td>
                </tr>
                <tr>
                    <th class="px-4 py-2 text-left font-semibold text-gray-700">Produits associés</th>
                    <td class="px-4 py-2">{{ category.products|length }}</td>
                </tr>
            </table>

            <div class="mt-6 flex space-x-4">
                <a href="{{ path('category_edit', {'id': category.id}) }}"
                   class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                    Éditer
                </a>
                <a href="{{ path('category_index') }}"
                   class="bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded">
                    Retour à la liste
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
