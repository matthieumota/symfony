{% extends 'base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
    <div class="container mx-auto px-4 py-8">
        <div class="bg-white rounded-lg shadow-xl p-6">
            <div class="flex justify-between items-center mb-6">
                <h1 class="text-3xl font-bold text-gray-900">Produits</h1>
                <a href="{{ path('product_new') }}"
                   class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                    + Nouveau Produit
                </a>
            </div>

            {% for message in app.flashes('success') %}
                <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-4">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('danger') %}
                <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-4">
                    {{ message }}
                </div>
            {% endfor %}

            <div class="overflow-x-auto">
                <table class="min-w-full bg-white">
                    <thead>
                        <tr>
                            <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                Nom
                            </th>
                            <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                Slug
                            </th>
                            <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                Prix
                            </th>
                            <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                Quantité
                            </th>
                            <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                Catégorie
                            </th>
                            <th class="px-6 py-3 border-b-2 border-gray-300 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in products %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 border-b border-gray-200">
                                {{ product.name }}
                            </td>
                            <td class="px-6 py-4 border-b border-gray-200">
                                <code class="bg-gray-100 px-2 py-1 rounded text-sm">{{ product.slug }}</code>
                            </td>
                            <td class="px-6 py-4 border-b border-gray-200">
                                {{ product.price|number_format(2, ',', ' ') }} €
                            </td>
                            <td class="px-6 py-4 border-b border-gray-200">
                                {% if product.quantity > 0 %}
                                    <span class="text-green-600">{{ product.quantity }}</span>
                                {% else %}
                                    <span class="text-red-600">Rupture</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 border-b border-gray-200">
                                <a href="{{ path('category_show', {'id': product.category.id}) }}"
                                   class="text-blue-600 hover:text-blue-900">
                                    {{ product.category.name }}
                                </a>
                            </td>
                            <td class="px-6 py-4 border-b border-gray-200">
                                <div class="flex space-x-2">
                                    <a href="{{ path('product_show', {'id': product.id}) }}"
                                       class="text-blue-600 hover:text-blue-900">Voir</a>
                                    <a href="{{ path('product_edit', {'id': product.id}) }}"
                                       class="text-green-600 hover:text-green-900">Éditer</a>
                                    {{ include('product/_delete_form.html.twig', {'product': product}) }}
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="px-6 py-4 border-b border-gray-200 text-center">
                                Aucun produit trouvé.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
