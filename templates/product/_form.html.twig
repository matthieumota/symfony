{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
    <div>
        {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
        {{ form_widget(form.name, {'attr': {'class': 'form-control w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500'}}) }}
        {{ form_help(form.name, {'help_attr': {'class': 'mt-1 text-sm text-gray-600'}}) }}
        {{ form_errors(form.name) }}
    </div>

    <div>
        {{ form_label(form.slug, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
        {{ form_widget(form.slug, {'attr': {'class': 'form-control w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500'}}) }}
        {{ form_help(form.slug, {'help_attr': {'class': 'mt-1 text-sm text-gray-600'}}) }}
        {{ form_errors(form.slug) }}
    </div>

    <div>
        {{ form_label(form.price, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
        {{ form_widget(form.price, {'attr': {'class': 'form-control w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500'}}) }}
        {{ form_help(form.price, {'help_attr': {'class': 'mt-1 text-sm text-gray-600'}}) }}
        {{ form_errors(form.price) }}
    </div>

    <div>
        {{ form_label(form.quantity, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
        {{ form_widget(form.quantity, {'attr': {'class': 'form-control w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500'}}) }}
        {{ form_help(form.quantity, {'help_attr': {'class': 'mt-1 text-sm text-gray-600'}}) }}
        {{ form_errors(form.quantity) }}
    </div>

    <div>
        {{ form_label(form.category, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
        {{ form_widget(form.category, {'attr': {'class': 'form-control w-full'}}) }}
        {{ form_help(form.category, {'help_attr': {'class': 'mt-1 text-sm text-gray-600'}}) }}
        {{ form_errors(form.category) }}
    </div>

    <div>
        {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
        {{ form_widget(form.description, {'attr': {'class': 'form-control w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500', 'rows': 5}}) }}
        {{ form_help(form.description, {'help_attr': {'class': 'mt-1 text-sm text-gray-600'}}) }}
        {{ form_errors(form.description) }}
    </div>

    <button type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
        {{ button_label|default('Enregistrer') }}
    </button>
{{ form_end(form) }}
