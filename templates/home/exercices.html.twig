{% extends 'base.html.twig' %}

{% block title %}Exercices Stimulus{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-10">
    <div class="container mx-auto px-4 max-w-3xl">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Exercices Stimulus</h1>
        <p class="text-gray-500 mb-8">Démonstration des controllers Stimulus implémentés.</p>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Hello</h2>
            <p class="text-sm text-gray-500 mb-4">Targets, values, classes, événements custom</p>
            <div {{ stimulus_controller('hello', { username: 'Fiorella' }) }}
                 data-hello-little-class="text-red-500"
                 data-hello-big-class="text-4xl"
                 data-hello-equal-class="text-green-500"
                 class="space-y-2">
                <input type="text" data-hello-target="username" data-action="input->hello#updateUsername"
                       class="border rounded px-3 py-1 w-full">
                <span data-hello-target="output" class="block"></span>
                <div class="flex gap-2">
                    <button class="bg-blue-600 text-white px-4 py-1 rounded" data-action="click->hello#greet">Go</button>
                    <button class="bg-gray-200 px-4 py-1 rounded" data-action="click->hello#add">Ajouter</button>
                </div>
                <div data-hello-target="list"></div>
            </div>
        </section>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Clock</h2>
            <p class="text-sm text-gray-500 mb-4">Lifecycle connect/disconnect, setInterval, événement custom</p>
            <div {{ stimulus_controller('clock') }}
                 data-action="hello:greeted@window->clock#destroy"
                 class="flex items-center gap-4">
                <span data-clock-target="output" class="font-mono text-lg"></span>
                <button class="bg-red-500 text-white px-4 py-1 rounded" data-action="click->clock#destroy">Cacher</button>
            </div>
        </section>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Counter</h2>
            <p class="text-sm text-gray-500 mb-4">Values, targets, params</p>
            <div {{ stimulus_controller('counter', { count: 10 }) }} class="flex items-center gap-4">
                <button class="bg-gray-200 px-4 py-2 rounded text-xl font-bold" data-action="dblclick->counter#decrement">−</button>
                <span data-counter-target="output" class="text-2xl font-mono w-10 text-center"></span>
                <button class="bg-gray-200 px-4 py-2 rounded text-xl font-bold"
                        data-action="click->counter#increment"
                        data-counter-step-param="1">+</button>
            </div>
        </section>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Compteur de caractères</h2>
            <p class="text-sm text-gray-500 mb-4">Values, targets, callback valueChanged</p>
            <div {{ stimulus_controller('char-counter', { max: 280 }) }}>
                <textarea data-action="input->char-counter#update" data-char-counter-target="textarea" rows="4" class="w-full border rounded px-3 py-2"></textarea>
                <p class="text-sm text-gray-600 mt-1">Caractères restants : <span data-char-counter-target="counter"></span></p>
            </div>
        </section>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Clipboard</h2>
            <p class="text-sm text-gray-500 mb-4">Targets, navigator.clipboard, setTimeout</p>
            <div {{ stimulus_controller('clipboard') }} class="flex items-center gap-4">
                <code data-clipboard-target="source" class="bg-gray-100 px-3 py-2 rounded text-sm">npm install @hotwired/stimulus</code>
                <button data-clipboard-target="button"
                        data-action="click->clipboard#copy"
                        class="bg-gray-800 text-white px-4 py-2 rounded text-sm">Copier</button>
            </div>
        </section>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Tabs</h2>
            <p class="text-sm text-gray-500 mb-4">Targets multiples, classes, params</p>
            <div {{ stimulus_controller('tabs', {}, { active: 'font-bold border-b-2 border-blue-600 text-blue-600' }) }}>
                <div class="flex gap-2 border-b mb-4">
                    <button class="px-4 py-2"
                            data-tabs-target="tab"
                            data-action="click->tabs#show"
                            data-tabs-index-param="0">Onglet 1</button>
                    <button class="px-4 py-2"
                            data-tabs-target="tab"
                            data-action="click->tabs#show"
                            data-tabs-index-param="1">Onglet 2</button>
                    <button class="px-4 py-2"
                            data-tabs-target="tab"
                            data-action="click->tabs#show"
                            data-tabs-index-param="2">Onglet 3</button>
                </div>
                <div data-tabs-target="panel" class="p-4 bg-gray-50 rounded">Contenu du panel 1</div>
                <div data-tabs-target="panel" class="p-4 bg-gray-50 rounded">Contenu du panel 2</div>
                <div data-tabs-target="panel" class="p-4 bg-gray-50 rounded">Contenu du panel 3</div>
            </div>
        </section>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Panier</h2>
            <p class="text-sm text-gray-500 mb-4">Array value, valueChanged, params</p>
            <div {{ stimulus_controller('cart') }}>
                <div class="flex flex-wrap gap-2 mb-4">
                    {% for product in products %}
                        <button data-action="cart#add"
                                data-cart-name-param="{{ product.name }}"
                                data-cart-price-param="{{ product.price }}"
                                class="bg-blue-600 text-white px-3 py-1 rounded text-sm">
                            Ajouter {{ product.name }} ({{ product.price }}€)
                        </button>
                    {% endfor %}
                </div>
                <ul data-cart-target="list" class="divide-y mb-3"></ul>
                <p class="font-semibold">Total : <strong data-cart-target="total">0</strong>€</p>
            </div>
        </section>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Search</h2>
            <p class="text-sm text-gray-500 mb-4">Fetch, debounce, targets</p>
            <div {{ stimulus_controller('search', { url: path('product_search') }) }}>
                <input type="text"
                       data-action="input->search#debounce"
                       placeholder="Rechercher un produit..."
                       class="border rounded px-3 py-2 w-full mb-2">
                <p data-search-target="status" hidden class="text-sm text-gray-400">Chargement...</p>
                <ul data-search-target="results" class="divide-y"></ul>
            </div>
        </section>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Toggle</h2>
            <p class="text-sm text-gray-500 mb-4">Targets, afficher/masquer un élément</p>
            <div {{ stimulus_controller('toggle') }}>
                <button class="bg-indigo-600 text-white px-4 py-1 rounded" data-action="click->toggle#toggle" data-toggle-target="button">Voir</button>
                <div data-toggle-target="content" hidden class="mt-3 p-4 bg-indigo-50 rounded">
                    <p>Ce contenu est caché par défaut.</p>
                </div>
            </div>
        </section>
    </div>
</div>
{% endblock %}
