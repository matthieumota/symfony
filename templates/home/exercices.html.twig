{% extends 'base.html.twig' %}

{% block title %}Exercices Stimulus{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-10">
    <div class="container mx-auto px-4 max-w-3xl">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Exercices Stimulus</h1>
        <p class="text-gray-500 mb-8">Démonstration des controllers Stimulus implémentés.</p>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Hello</h2>
            <p class="text-sm text-gray-500 mb-4">Targets, values, classes, événements custom</p>
            <div {{ stimulus_controller('hello', { username: 'Fiorella' }) }}
                 data-hello-little-class="text-red-500"
                 data-hello-big-class="text-4xl"
                 data-hello-equal-class="text-green-500"
                 class="space-y-2">
                <input type="text" data-hello-target="username" data-action="input->hello#updateUsername"
                       class="border rounded px-3 py-1 w-full">
                <span data-hello-target="output" class="block"></span>
                <div class="flex gap-2">
                    <button class="bg-blue-600 text-white px-4 py-1 rounded" data-action="click->hello#greet">Go</button>
                    <button class="bg-gray-200 px-4 py-1 rounded" data-action="click->hello#add">Ajouter</button>
                </div>
                <div data-hello-target="list"></div>
            </div>
        </section>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Clock</h2>
            <p class="text-sm text-gray-500 mb-4">Lifecycle connect/disconnect, setInterval, événement custom</p>
            <div {{ stimulus_controller('clock') }}
                 data-action="hello:greeted@window->clock#destroy"
                 class="flex items-center gap-4">
                <span data-clock-target="output" class="font-mono text-lg"></span>
                <button class="bg-red-500 text-white px-4 py-1 rounded" data-action="click->clock#destroy">Cacher</button>
            </div>
        </section>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Counter</h2>
            <p class="text-sm text-gray-500 mb-4">Values, targets, params</p>
            <div {{ stimulus_controller('counter', { count: 10 }) }} class="flex items-center gap-4">
                <button class="bg-gray-200 px-4 py-2 rounded text-xl font-bold" data-action="dblclick->counter#decrement">−</button>
                <span data-counter-target="output" class="text-2xl font-mono w-10 text-center"></span>
                <button class="bg-gray-200 px-4 py-2 rounded text-xl font-bold"
                        data-action="click->counter#increment"
                        data-counter-step-param="1">+</button>
            </div>
        </section>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Compteur de caractères</h2>
            <p class="text-sm text-gray-500 mb-4">Values, targets, callback valueChanged</p>
            <div {{ stimulus_controller('char-counter', { max: 280 }) }}>
                <textarea data-action="input->char-counter#update" rows="4" class="w-full border rounded px-3 py-2" maxlength="300"></textarea>
                <p class="text-sm text-gray-600 mt-1">Caractères restants : <span data-char-counter-target="counter">280</span></p>
            </div>
        </section>

        <section class="bg-white rounded-lg shadow p-6 mb-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Toggle</h2>
            <p class="text-sm text-gray-500 mb-4">Targets, afficher/masquer un élément</p>
            <div {{ stimulus_controller('toggle') }}>
                <button class="bg-indigo-600 text-white px-4 py-1 rounded" data-action="click->toggle#toggle" data-toggle-target="button">Voir</button>
                <div data-toggle-target="content" hidden class="mt-3 p-4 bg-indigo-50 rounded">
                    <p>Ce contenu est caché par défaut.</p>
                </div>
            </div>
        </section>
    </div>
</div>
{% endblock %}
