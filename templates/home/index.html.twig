{% extends 'base.html.twig' %}

{% block title %}{{ project_name }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100">
    <div class="container mx-auto px-4 py-12">
        <div class="max-w-4xl mx-auto">
            <div class="bg-white rounded-lg shadow-xl p-8 mb-8">
                <h1 class="text-4xl font-bold text-gray-900 mb-4">
                    {{ project_name }}
                </h1>
                <div class="flex items-center space-x-4 mb-6">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                        Symfony {{ sf_version }}
                    </span>
                    <span class="text-gray-500">→</span>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
                        Symfony 7
                    </span>
                </div>
                <p class="text-gray-600 text-lg mb-6">
                    Application CRUD de démonstration pour la formation de migration Symfony 5 vers Symfony 7.
                </p>

                <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-yellow-700">
                                <strong>Note importante :</strong> Ce projet utilise volontairement des patterns Symfony 5.4 (annotations PHP, configurations deprecated) pour illustrer les étapes de migration vers Symfony 7.
                            </p>
                        </div>
                    </div>
                </div>

                <h2 class="text-2xl font-semibold text-gray-800 mb-4">🚀 Fonctionnalités disponibles</h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="border border-gray-200 rounded-lg p-5 hover:shadow-md transition bg-green-50 border-green-200">
                        <div class="flex items-center mb-3">
                            <span class="text-2xl mr-3">🏷️</span>
                            <h3 class="text-lg font-semibold text-gray-800">CRUD Catégories</h3>
                            <span class="ml-2 px-2 py-0.5 bg-green-100 text-green-800 text-xs rounded-full">Disponible</span>
                        </div>
                        <p class="text-gray-600 text-sm mb-3">Gestion complète des catégories (CRUD)</p>
                        <a href="{{ path('category_index') }}"
                           class="inline-block bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded text-sm">
                            Accéder aux Catégories →
                        </a>
                    </div>

                    <div class="border border-gray-200 rounded-lg p-5 hover:shadow-md transition bg-green-50 border-green-200">
                        <div class="flex items-center mb-3">
                            <span class="text-2xl mr-3">📦</span>
                            <h3 class="text-lg font-semibold text-gray-800">CRUD Produits</h3>
                            <span class="ml-2 px-2 py-0.5 bg-green-100 text-green-800 text-xs rounded-full">Disponible</span>
                        </div>
                        <p class="text-gray-600 text-sm mb-3">Gestion complète des produits avec catégories</p>
                        <a href="{{ path('product_index') }}"
                           class="inline-block bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded text-sm">
                            Accéder aux Produits →
                        </a>
                    </div>

                    <div class="border border-gray-200 rounded-lg p-5 hover:shadow-md transition bg-green-50 border-green-200">
                        <div class="flex items-center mb-3">
                            <span class="text-2xl mr-3">🔐</span>
                            <h3 class="text-lg font-semibold text-gray-800">Authentification</h3>
                            <span class="ml-2 px-2 py-0.5 bg-green-100 text-green-800 text-xs rounded-full">Disponible</span>
                        </div>
                        <p class="text-gray-600 text-sm mb-3">Système de login/logout avec rôles (Admin/User)</p>
                        {% if not app.user %}
                            <a href="{{ path('app_login') }}"
                               class="inline-block bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded text-sm">
                                Se connecter →
                            </a>
                        {% else %}
                            <span class="inline-block text-green-700 font-semibold text-sm">
                                Connecté en tant que {{ app.user.email }}
                            </span>
                        {% endif %}
                    </div>

                    <div class="border border-gray-200 rounded-lg p-5 hover:shadow-md transition bg-green-50 border-green-200">
                        <div class="flex items-center mb-3">
                            <span class="text-2xl mr-3">📊</span>
                            <h3 class="text-lg font-semibold text-gray-800">Dashboard Admin</h3>
                            <span class="ml-2 px-2 py-0.5 bg-green-100 text-green-800 text-xs rounded-full">Disponible</span>
                        </div>
                        <p class="text-gray-600 text-sm mb-3">Tableau de bord avec statistiques (réservé aux admins)</p>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('admin_dashboard') }}"
                               class="inline-block bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded text-sm">
                                Accéder au Dashboard →
                            </a>
                        {% else %}
                            <span class="inline-block text-gray-600 text-sm">
                                Connectez-vous en tant qu'admin pour y accéder
                            </span>
                        {% endif %}
                    </div>
                </div>

                <div class="mt-8 p-4 bg-green-50 border-l-4 border-green-500 rounded">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-green-700">
                                <strong>Dernière mise à jour :</strong> Catégories, Produits, Authentification et Dashboard Admin implémentés. Système complet avec 2 utilisateurs de démo (admin@example.com/admin123, user@example.com/user123).
                            </p>
                        </div>
                    </div>
                </div>

                <h2 class="text-2xl font-semibold text-gray-800 mt-8 mb-4">🎯 Points de migration à illustrer</h2>

                <div class="bg-gray-50 rounded-lg p-6">
                    <ul class="space-y-2">
                        <li class="flex items-start">
                            <span class="text-blue-500 mr-2">✓</span>
                            <span class="text-gray-700"><strong>Annotations PHP → Attributs PHP 8</strong> (@Route → #[Route])</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-500 mr-2">✓</span>
                            <span class="text-gray-700"><strong>Doctrine</strong> - Entity annotations et types de champs</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-500 mr-2">✓</span>
                            <span class="text-gray-700"><strong>Security</strong> - Nouveau système d'authentification</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-500 mr-2">✓</span>
                            <span class="text-gray-700"><strong>Forms</strong> - Options deprecated et nouveaux patterns</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-500 mr-2">✓</span>
                            <span class="text-gray-700"><strong>Webpack Encore → Asset Mapper</strong> - Gestion des assets</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-blue-500 mr-2">✓</span>
                            <span class="text-gray-700"><strong>Twig</strong> - Fonctions deprecated et nouvelles syntaxes</span>
                        </li>
                    </ul>
                </div>

                <div class="mt-8 flex items-center justify-between text-sm text-gray-500">
                    <div>
                        Version actuelle : <strong>Symfony {{ sf_version }}</strong>
                    </div>
                    <div>
                        PHP Version : <strong>7.4+</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
